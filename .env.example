# Choose a long random URL-safe password before first start (e.g. openssl rand -hex 24).
POSTGRES_PASSWORD=replace-with-random-hex

# Dedicated Gmail account receiving only rental alerts. Keep credentials in .env, never in Git.
MAIL_PROVIDER=gmail
MAIL_HOST=imap.gmail.com
MAIL_PORT=993
MAIL_USERNAME=your-rental-mailbox@gmail.com
MAIL_PASSWORD=replace-with-gmail-app-password
MAIL_TLS=true
MAILBOX=INBOX
EMAIL_SOURCE_NAME=rental-alert-email
EMAIL_SEARCH_SINCE_DAYS=2
# Optional regex to restrict links to an authorized alert source.
EMAIL_LINK_PATTERN=

# Matching criteria
MAX_MONTHLY_RENT=2500
MIN_BEDROOMS=1
AREAS=Islington,Hackney,Southwark
MAX_COMMUTE_MINUTES=45
# Legacy single destination used by the TfL provider.
COMMUTE_DESTINATION=

# Commute enrichment. Google Routes can calculate walking and public transport to named destinations.
# Keep GOOGLE_MAPS_API_KEY only in the untracked .env file.
COMMUTE_PROVIDER=tfl
COMMUTE_DESTINATION_1_NAME=Destination A
COMMUTE_DESTINATION_1=
COMMUTE_DESTINATION_2_NAME=Destination B
COMMUTE_DESTINATION_2=
COMMUTE_MODES=walking,transit
# Optional daily local departure time (or a full RFC3339 timestamp) for expected transit routing.
GOOGLE_MAPS_API_KEY=
GOOGLE_TRANSIT_DEPARTURE_TIME=08:30
GOOGLE_TRANSIT_TIMEZONE=Europe/London

# Optional digest delivery. Without these values, digest is printed to stdout.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
DIGEST_FROM=alerts@example.com
DIGEST_TO=you@example.com
DIGEST_HOUR_UTC=8

# Optional immediate Telegram notifications for newly matching listings.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WORKER_INTERVAL_SECONDS=1800

# Optional daily AI suggestions. Disabled until a server-side key and model are configured.
AI_REVIEW_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
AI_REVIEW_HOUR_UTC=7
AI_MAX_LISTINGS_PER_DAY=5

# Single-listing detail review. Enable only for sources covered by recorded permission.
DETAIL_REVIEW_ENABLED=false
DETAIL_PAGES_PER_CYCLE=0
DETAIL_ALLOWED_DOMAINS=
DETAIL_PROVIDER_AUTHORIZED_DOMAINS=
DETAIL_TIMEOUT_SECONDS=15
DETAIL_MAX_BYTES=2000000
DETAIL_MAX_REDIRECTS=3
DETAIL_USER_AGENT=london-rental-intelligence-bot-detail-viewer/0.1

# Optional map coordinate enrichment. Google Maps is used when GOOGLE_MAPS_API_KEY is set.
GEOCODING_ENABLED=false
GEOCODING_USER_AGENT=london-rental-intelligence-bot/0.1 contact@example.com
